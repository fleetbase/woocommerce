{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fleetbase/delivery-time",
	"version": "1.0.0",
	"title": "Delivery time",
	"description": "Lets the customer choose when a Fleetbase delivery should arrive.",
	"category": "woocommerce",
	"icon": "clock",
	"parent": [ "woocommerce/checkout-shipping-methods-block" ],
	"attributes": {
		"lock": {
			"type": "object",
			"default": { "remove": true, "move": true }
		}
	},
	"supports": { "html": false, "multiple": false, "reusable": false },
	"textdomain": "fleetbase-for-woocommerce"
}
